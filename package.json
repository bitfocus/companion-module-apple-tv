{
  "name": "companion-module-apple-tv",
  "version": "1.0.2",
  "main": "dist/main.js",
  "type": "module",
  "scripts": {
    "postinstall": "husky",
    "format": "prettier -w .",
    "package": "run build && companion-module-build",
    "build": "rimraf dist && run build:main",
    "build:main": "tsc -p tsconfig.build.json",
    "build:all": "run build && run build:tools",
    "build:tools": "rimraf dist-tools && tsc -p tsconfig.tools.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "lint:raw": "eslint",
    "lint": "run lint:raw .",
    "test": "run build:all && node --test tests/*.test.mjs",
    "test:package": "node tests/package-smoke.mjs",
    "companion:install": "run package && run build:tools && node dist-tools/tools/install-companion.js"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bitfocus/companion-module-apple-tv.git"
  },
  "engines": {
    "node": "^26",
    "yarn": "^4"
  },
  "dependencies": {
    "@companion-module/base": "~2.2.1",
    "node-appletv-remote": "patch:node-appletv-remote@npm%3A0.5.0#~/patches/node-appletv-remote-npm-0.5.0-5edebab564.patch"
  },
  "devDependencies": {
    "@companion-module/tools": "^3.2.0",
    "@types/node": "^26.6.5",
    "eslint": "^10.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "rimraf": "^6.1.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2"
  },
  "prettier": "@companion-module/tools/.prettierrc.json",
  "lint-staged": {
    "*.{css,json,md,scss}": [
      "prettier --write"
    ],
    "*.{ts,tsx,js,jsx}": [
      "yarn lint:raw --fix"
    ]
  },
  "packageManager": "yarn@4.17.0",
  "files": [
    "dist",
    "companion",
    "LICENSE"
  ]
}
